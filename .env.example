# Copy to .env. The defaults match docker-compose.dev.yml and are for a
# development machine only.

# The database owner: runs migrations.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5435/jude
# The application's own role, subject to row-level security.
APP_DATABASE_URL=postgres://jude_app:jude_app@127.0.0.1:5435/jude
# The password migrations give jude_app; must match APP_DATABASE_URL.
JUDE_APP_PASSWORD=jude_app

# Set to "open" to let more than the first person create an account.
# JUDE_SIGNUP=open

# Only when hosting for others: who runs this installation (see docs/self-hosting.md).
# JUDE_OPERATOR_NAME=
# JUDE_OPERATOR_EMAIL=
# JUDE_OPERATOR_ADDRESS=
# JUDE_HOSTING=

# Encrypts the two-step secrets at rest. At least 32 random characters;
# keep it out of the repository and do not change it once people use 2FA.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JUDE_SECRET=

# The address Jude is served from, e.g. https://jude.example.dk.
# Passkeys are bound to it. On localhost it may be left out.
# JUDE_URL=

# Mistral (EU) for speech, the role and the feedback. Make a key in Mistral's
# console in a window nobody else can see, and paste it here only.
MISTRAL_API_KEY=
# Optional model choices; the defaults are in src/services/mistral.ts.
# JUDE_CHAT_MODEL=mistral-medium-latest
# JUDE_TRANSCRIBE_MODEL=voxtral-mini-transcribe-3
# JUDE_SPEECH_MODEL=voxtral-mini-tts-3-0
# JUDE_MODERATION_MODEL=mistral-moderation-2603

# The voices, cloned from consented recordings (docs/voices.md), as JSON.
# Without any, the other person answers with subtitles only.
# JUDE_VOICES=[{"id":"rolig-kvinde","label":"Rolig","gender":"kvinde","ageMin":40,"ageMax":70,"voiceId":"..."}]

# The cost ceilings (src/domain/limits.ts); the defaults suit a small demo.
# JUDE_MINUTES_PER_CONVERSATION=15
# JUDE_TURNS_PER_CONVERSATION=40
# JUDE_ACCOUNT_CONVERSATIONS_PER_DAY=3
# JUDE_SERVER_CONVERSATIONS_PER_DAY=300

# Development only: a scripted stand-in for Mistral, to try the screens
# without a key. Ignored when NODE_ENV is production.
# JUDE_FAKE_AI=on
