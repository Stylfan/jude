# Copy to .env.production and fill in. Never commit the copy.
# Make each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# The Postgres owner's password; used only by the migration step.
POSTGRES_PASSWORD=
# The application role's password (jude_app).
JUDE_APP_PASSWORD=
# Encrypts the two-step secrets at rest. Do not change it once people use 2FA.
JUDE_SECRET=
# The public address, with https. Passkeys are bound to it.
JUDE_URL=https://coach.example.dk
# "open" lets more than the first person create an account.
JUDE_SIGNUP=

# Only when you host Jude for other people: who runs it. With a name
# and an address to write to, the sign-in pages link to a privacy policy
# and terms in that name (/privatliv and /vilkaar); without, there are none.
JUDE_OPERATOR_NAME=
JUDE_OPERATOR_EMAIL=
# Address and CVR number on one line, e.g. "Vej 1, 1000 København · CVR 12345678".
JUDE_OPERATOR_ADDRESS=
# Who runs the server and backups for you, e.g. "Hetzner Online GmbH i Tyskland".
JUDE_HOSTING=

# "on" makes this a demo: visitors press one button and get a throwaway
# account, deleted with its profile after 24 hours; no sign-up.
JUDE_DEMO=
# Where visitors fetch the code; defaults to the GitHub repository.
JUDE_SOURCE_URL=

# Mistral (EU). Make the key in Mistral's console on a paid plan, so the
# data is not used for training; paste it here only, never in the code.
MISTRAL_API_KEY=
# The cloned Danish voices as JSON (docs/voices.md). Empty: subtitles only.
JUDE_VOICES=
# The cost ceilings; empty means the defaults in src/domain/limits.ts.
JUDE_MINUTES_PER_CONVERSATION=
JUDE_TURNS_PER_CONVERSATION=
JUDE_ACCOUNT_CONVERSATIONS_PER_DAY=
JUDE_SERVER_CONVERSATIONS_PER_DAY=
